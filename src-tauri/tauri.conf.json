{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doopoo",
  "version": "0.1.0",
  "identifier": "ai.doopoo.desktop",
  "build": {
    "devUrl": "http://localhost:8080",
    "frontendDist": "https://doopoo.ai"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doopoo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Doopoo",
    "shortDescription": "Doopoo AI Creative Studio",
    "longDescription": "Doopoo desktop app. Opens the hosted studio in a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
